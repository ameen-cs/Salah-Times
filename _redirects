# Map legacy/variant Apple touch icon paths that iOS probes automatically
# to the single real icon, so they return 200 instead of 404.
/apple-touch-icon.png                        /logo.png   200
/apple-touch-icon-precomposed.png            /logo.png   200
/apple-touch-icon-120x120.png                /logo.png   200
/apple-touch-icon-120x120-precomposed.png    /logo.png   200
